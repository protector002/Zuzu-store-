{
  "entities": {
    "StoreApp": {
      "title": "StoreApp",
      "description": "An Android application available on the store for direct download",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the application"
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug for the application"
        },
        "name": {
          "type": "string",
          "description": "Display title of the application"
        },
        "tagline": {
          "type": "string",
          "description": "Short summary or subtitle"
        },
        "description": {
          "type": "string",
          "description": "Full description of the application features"
        },
        "iconUrl": {
          "type": "string",
          "description": "URL or data URI for the app icon"
        },
        "heroImageUrl": {
          "type": "string",
          "description": "Cover hero banner image URL"
        },
        "category": {
          "type": "string",
          "description": "Store category"
        },
        "rating": {
          "type": "number",
          "description": "Average user rating"
        },
        "ratingCount": {
          "type": "number",
          "description": "Count of submitted reviews"
        },
        "downloadsTotal": {
          "type": "number",
          "description": "Total public download count"
        },
        "currentVersion": {
          "type": "string",
          "description": "Current live version string"
        },
        "packageId": {
          "type": "string",
          "description": "Android package identifier"
        },
        "isOfficial": {
          "type": "boolean",
          "description": "Whether package is marked official"
        },
        "displayOrder": {
          "type": "number",
          "description": "Storefront ranking display order where 1 is top/first"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether designated as the top Hero spotlight and #1 in For You"
        },
        "isPinnedToTop": {
          "type": "boolean",
          "description": "Whether explicitly pinned to the top of the catalog"
        },
        "pricing": {
          "type": "object",
          "description": "Monetization model whether free or paid with price and currency"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name", "slug"]
    },
    "DeveloperAccount": {
      "title": "DeveloperAccount",
      "description": "Registered developer profile for publishing and managing apps",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique developer ID"
        },
        "name": {
          "type": "string",
          "description": "Developer or studio name"
        },
        "email": {
          "type": "string",
          "description": "Developer login email"
        },
        "passwordHash": {
          "type": "string",
          "description": "Hashed developer password"
        },
        "companyName": {
          "type": "string",
          "description": "Optional company or studio name"
        },
        "status": {
          "type": "string",
          "enum": ["active", "frozen", "banned"],
          "description": "Account status managed by Super Admin"
        },
        "banReason": {
          "type": "string",
          "description": "Reason for account moderation"
        },
        "bannedAt": {
          "type": "string",
          "description": "ISO timestamp when moderated"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of registration"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name", "email"]
    },
    "AdminBroadcast": {
      "title": "AdminBroadcast",
      "description": "Storewide alert banner broadcast by Super Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Broadcast identifier"
        },
        "message": {
          "type": "string",
          "description": "Broadcast message text"
        },
        "level": {
          "type": "string",
          "enum": ["info", "warning", "alert"],
          "description": "Banner severity"
        },
        "active": {
          "type": "boolean",
          "description": "Whether banner is currently displayed"
        },
        "link": {
          "type": "string",
          "description": "Optional action URL"
        },
        "linkText": {
          "type": "string",
          "description": "Optional action text"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO update timestamp"
        }
      },
      "required": ["message", "active"]
    },
    "AppSaleTransaction": {
      "title": "AppSaleTransaction",
      "description": "Sale record of paid application with 6 percent admin commission deduction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string" },
        "appName": { "type": "string" },
        "developerId": { "type": "string" },
        "developerEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "grossAmount": { "type": "number" },
        "adminCommissionPercent": { "type": "number" },
        "adminCommissionAmount": { "type": "number" },
        "developerNetAmount": { "type": "number" },
        "currency": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "appId", "developerId", "grossAmount", "adminCommissionAmount", "developerNetAmount"]
    },
    "DeveloperWallet": {
      "title": "DeveloperWallet",
      "description": "Developer financial wallet balance, gross sales, 6 percent fee total, and net available balance",
      "type": "object",
      "properties": {
        "developerId": { "type": "string" },
        "totalGrossRevenue": { "type": "number" },
        "totalAdminFeesPaid": { "type": "number" },
        "totalNetEarnings": { "type": "number" },
        "totalWithdrawn": { "type": "number" },
        "availableBalance": { "type": "number" },
        "pendingWithdrawals": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["developerId", "availableBalance"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Developer payout request with minimum 1000 threshold and mobile money or bank details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "developerId": { "type": "string" },
        "developerName": { "type": "string" },
        "developerEmail": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "payoutMethod": { "type": "string" },
        "status": { "type": "string" },
        "requestedAt": { "type": "string" }
      },
      "required": ["id", "developerId", "amount", "payoutMethod", "status"]
    },
    "AppTransferListing": {
      "title": "AppTransferListing",
      "description": "Developer-to-developer paid app ownership sale listing and transfer record with 10 percent admin fee",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "appId": { "type": "string" },
        "appName": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerEmail": { "type": "string" },
        "buyerId": { "type": "string" },
        "buyerEmail": { "type": "string" },
        "askingPrice": { "type": "number" },
        "adminFeePercent": { "type": "number" },
        "adminFeeAmount": { "type": "number" },
        "sellerNetAmount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "appId", "sellerId", "askingPrice", "adminFeePercent", "status"]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": {
        "$ref": "#/entities/StoreApp"
      },
      "description": "Public store apps catalog accessible to all users for browsing and downloading"
    },
    "/developers/{devId}": {
      "schema": {
        "$ref": "#/entities/DeveloperAccount"
      },
      "description": "Permanent developer account profiles and credentials"
    },
    "/broadcasts/{broadcastId}": {
      "schema": {
        "$ref": "#/entities/AdminBroadcast"
      },
      "description": "Live broadcast notices issued by Super Admin"
    },
    "/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/AppSaleTransaction"
      },
      "description": "Financial sales ledger documenting gross revenue and 6 percent platform fees"
    },
    "/wallets/{walletId}": {
      "schema": {
        "$ref": "#/entities/DeveloperWallet"
      },
      "description": "Permanent developer wallet balances and net earnings"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": {
        "$ref": "#/entities/WithdrawalRequest"
      },
      "description": "Developer payout requests subject to minimum 1000 threshold and admin approval"
    },
    "/app_transfers/{transferId}": {
      "schema": {
        "$ref": "#/entities/AppTransferListing"
      },
      "description": "Developer-to-developer paid app ownership sale listings and completed ownership transfers"
    }
  }
}
