# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LIVEPAY_API_KEY: LivePay Africa / Uganda API Key for processing Mobile Money collections and payouts.
LIVEPAY_API_KEY="MY_LIVEPAY_API_KEY"

# LIVEPAY_WEBHOOK_SECRET: Webhook signing secret from LivePay merchant dashboard.
LIVEPAY_WEBHOOK_SECRET="MY_LIVEPAY_WEBHOOK_SECRET"

# LIVEPAY_ACCOUNT_NUMBER: LivePay business account number (e.g. LP260805074398).
LIVEPAY_ACCOUNT_NUMBER="MY_LIVEPAY_ACCOUNT_NUMBER"
