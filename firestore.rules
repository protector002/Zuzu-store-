rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Apps catalog: Everyone can read so all shared users see apps instantly without an account
    match /apps/{appId} {
      allow read: if true;
      allow write: if true;
    }

    // Developer accounts for persistent registration and management
    match /developers/{devId} {
      allow read: if true;
      allow write: if true;
    }

    // Live Super Admin broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if true;
    }

    // App sales ledger & 6% commission records
    match /sales/{saleId} {
      allow read: if true;
      allow write: if true;
    }

    // Developer wallets & net balances
    match /wallets/{walletId} {
      allow read: if true;
      allow write: if true;
    }

    // Developer withdrawal requests
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if true;
    }

    match /deleted_records/{docId} {
      allow read, write: if true;
    }

    // Developer-to-developer paid app ownership transfers
    match /app_transfers/{transferId} {
      allow read, write: if true;
    }

    // Protector Technologies user & developer agreement acceptances
    match /agreements/{acceptanceId} {
      allow read, write: if true;
    }

    // Automated transactional dispatch logs
    match /email_logs/{logId} {
      allow read, write: if true;
    }

    // In-app developer inbox notifications
    match /developer_notifications/{notifId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
